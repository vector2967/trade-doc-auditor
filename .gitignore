# Markdown (planning/design/handoff docs — kept local, not committed)
*.md

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Secrets / env
.env
.env.*
!.env.example

# Data caches / large artifacts
*.npy
**/data/raw/
# 법령 본문·MST 캐시는 커밋 (API 쿼터/장애와 무관하게 재적재 가능해야 — Actions ingest 도 이걸 사용)
!law_repository/data/raw/
!law_repository/data/raw/**

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# API sweep 진행 캐시/로그 (재생성 가능)
**/data/ccct_*
# 단, 전수 스윕 결과는 커밋 (재수집에 쿼터 3일 — 팀원은 --load-only 로 즉시 적재)
!law_repository/data/ccct_progress.jsonl

# 팀원용 셋업 가이드·배포 문서는 커밋 (*.md 무시의 예외)
!law_repository/README.md
!law_repository/deploy/**
# 단, 실비밀 파일은 deploy/** 예외보다 뒤에서 다시 차단 (뒤 규칙이 이김)
law_repository/deploy/.env.cloud

# recall 평가 리포트 커밋 (*.md 무시의 예외)
!law_repository/data/eval/*.md

# 시연 CLI(:조회) HTML 출력물 — 로컬 전용
demo_out/

# 실시간 LLM 재작성 런타임 캐시 — 로컬 전용
agent/data/query_rewrites_runtime.json
